{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AtmosTransport runtime configuration",
  "description": "Editor schema for TOML files consumed by scripts/run_transport.jl. Topology- and binary-capability checks are performed by the Julia runtime.",
  "type": "object",
  "required": ["input"],
  "additionalProperties": true,
  "properties": {
    "input": {
      "description": "Transport binaries to replay. Choose an explicit list or a folder with an inclusive date range.",
      "oneOf": [
        {
          "type": "object",
          "required": ["binary_paths"],
          "properties": {
            "binary_paths": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            }
          },
          "not": {"required": ["folder"]}
        },
        {
          "type": "object",
          "required": ["folder", "start_date", "end_date"],
          "properties": {
            "folder": {"type": "string"},
            "start_date": {"$ref": "#/definitions/date"},
            "end_date": {"$ref": "#/definitions/date"},
            "file_pattern": {
              "type": "string",
              "description": "Optional filename pattern containing exactly one {YYYYMMDD} placeholder."
            }
          },
          "not": {"required": ["binary_paths"]}
        }
      ],
      "properties": {
        "require_adaptive_substeps": {
          "type": "boolean",
          "default": false,
          "description": "Reject binaries that do not carry a per-window adaptive substep schedule."
        },
        "staging": {"$ref": "#/definitions/staging"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "use_gpu": {
          "type": "boolean",
          "default": false,
          "description": "Compatibility switch: when true and backend is absent, auto-detect a GPU."
        },
        "backend": {
          "type": "string",
          "enum": ["cpu", "auto", "cuda", "metal"],
          "description": "Compute backend. Metal requires Float32 numerics."
        }
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "float_type": {
          "type": "string",
          "enum": ["Float32", "Float64"],
          "default": "Float64",
          "description": "Floating-point type used by the runtime state."
        }
      }
    },
    "run": {
      "type": "object",
      "description": "Window bounds and state-reanchoring controls. Put advection options in [advection].",
      "additionalProperties": true,
      "properties": {
        "start_window": {"type": "integer", "minimum": 1, "default": 1},
        "stop_window": {"type": "integer", "minimum": 1},
        "air_mass_reset_mode": {
          "type": "string",
          "enum": ["none", "preserve_vmr", "preserve_tracer_mass"],
          "default": "preserve_tracer_mass"
        },
        "physics_cadence": {
          "type": "string",
          "enum": ["window", "substep"],
          "default": "window",
          "description": "On binaries with a per-window physics contract: convection and chemistry once per met window, or every advection substep."
        },
        "halo_padding": {
          "type": "integer",
          "minimum": 0,
          "description": "Cubed-sphere halo width. Normally inferred from the advection scheme."
        },
        "Hp": {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy alias for run.halo_padding."
        },
        "tracer_name": {
          "type": "string",
          "description": "Legacy single-tracer name used only when [tracers] is absent on structured grids."
        }
      }
    },
    "advection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scheme": {
          "type": "string",
          "enum": ["upwind", "slopes", "ppm", "linrood", "none"],
          "default": "upwind"
        },
        "ppm_order": {
          "type": "integer",
          "enum": [5, 7],
          "description": "Cubed-sphere Lin-Rood reconstruction order; valid only with scheme = \"linrood\"."
        },
        "vertical": {
          "type": "string",
          "enum": ["same_as_horizontal", "fv3_kord8", "fv3_kord8_signed", "upwind"],
          "description": "PPM: same_as_horizontal (default), fv3_kord8 or fv3_kord8_signed (cubed sphere). Lin-Rood: upwind (default), fv3_kord8 or fv3_kord8_signed."
        },
        "limiter": {
          "type": "string",
          "enum": ["monotone", "cw84"],
          "default": "monotone",
          "description": "PPM only: monotone, or cw84 for the complete Colella-Woodward scheme."
        }
      }
    },
    "diffusion": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "constant",
            "tm5_beljaars_viterbo_local_kz",
            "geoschem_holtslag_boville_vdiff",
            "tm5_dkg"
          ],
          "default": "none"
        },
        "value": {
          "type": "number",
          "description": "Constant Kz in m^2 s^-1 when kind = \"constant\"."
        },
        "surface_flux_boundary": {
          "type": "boolean",
          "default": false,
          "description": "Couple the surface source directly to the diffusion boundary condition."
        }
      }
    },
    "convection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["none", "tm5", "cmfmc", "cmfmc_matrix"],
          "default": "none"
        },
        "clamp": {
          "type": "boolean",
          "default": false,
          "description": "Enable the positivity clamp for the explicit CMFMC scheme."
        },
        "tile_workspace_gib": {"type": "number", "exclusiveMinimum": 0, "default": 1.0},
        "use_collab_lu": {"type": "boolean", "default": false},
        "lmax_conv": {"type": "integer", "minimum": 0, "default": 0},
        "n_merge": {"type": "integer", "minimum": 1, "default": 1}
      }
    },
    "chemistry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {"type": "string", "enum": ["none", "decay"], "default": "none"},
        "half_lives_seconds": {
          "type": "object",
          "description": "Positive first-order half-life keyed by tracer name.",
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "tracers": {
      "type": "object",
      "description": "Tracer definitions keyed by the output tracer name.",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/tracer"}
    },
    "output": {"$ref": "#/definitions/output"}
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "staging": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "dir": {"type": "string", "description": "Local staging directory; required when staging is enabled."},
        "lookahead_days": {"type": "integer", "minimum": 0, "default": 2},
        "keep_behind_days": {"type": "integer", "minimum": 0, "default": 0},
        "cleanup_on_exit": {"type": "boolean", "default": true}
      }
    },
    "tracer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "init": {"$ref": "#/definitions/initial_condition"},
        "surface_flux": {"$ref": "#/definitions/surface_flux"}
      }
    },
    "initial_condition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "uniform",
            "latitude_step",
            "lat_step",
            "hemisphere_step",
            "bl_enhanced",
            "gaussian_blob",
            "file",
            "netcdf",
            "file_field",
            "catrine_co2",
            "pressure_layer",
            "cs_native"
          ],
          "default": "uniform"
        },
        "background": {"type": "number"},
        "enhancement": {"type": "number"},
        "n_layers": {"type": "integer", "minimum": 1},
        "south_value": {"type": "number"},
        "north_value": {"type": "number"},
        "split_lat_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "lon0_deg": {"type": "number"},
        "lat0_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "sigma_lon_deg": {"type": "number", "exclusiveMinimum": 0},
        "sigma_lat_deg": {"type": "number", "exclusiveMinimum": 0},
        "amplitude": {"type": "number"},
        "file": {"type": "string"},
        "variable": {"type": "string"},
        "time_index": {"type": "integer", "minimum": 1},
        "vertical_order": {"type": "string", "enum": ["surface_first", "toa_first"]},
        "lowest_layer": {"type": "boolean", "default": false},
        "psurf_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "total_molecules": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "surface_flux": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["none", "file", "cs_native", "lmdz_co2", "gridfed_fossil_co2", "edgar_sf6", "zhang_rn222"]
        },
        "file": {"type": "string"},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "file_pattern": {"type": "string"},
        "year": {"type": "integer", "minimum": 1900, "maximum": 3000},
        "variable": {"type": "string"},
        "time_index": {"type": "integer", "minimum": 1},
        "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "scale": {"type": "number"},
        "molar_mass_kg_mol": {"type": "number", "exclusiveMinimum": 0},
        "time_varying": {"type": "boolean", "default": false},
        "temporal_scheme": {
          "type": "string",
          "enum": ["stepwise", "linear", "conservative"]
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Runtime snapshot output. Preferred keys are path, hours or cadence_hours, split, and format.",
      "additionalProperties": true,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "format": {"type": "string", "enum": ["netcdf", "binary_mmap"], "default": "netcdf"},
        "path": {"type": "string"},
        "hours": {"$ref": "#/definitions/hours"},
        "cadence_hours": {"type": "number", "exclusiveMinimum": 0},
        "start_hour": {"type": "number", "minimum": 0, "default": 0},
        "stop_hour": {"type": "number", "minimum": 0},
        "split": {
          "description": "AbstractOutputPartition for snapshot and observation files.",
          "default": "single",
          "oneOf": [
            {
              "const": "single",
              "description": "SingleOutputFile: one file for the whole run (aliases one_file, one-file)."
            },
            {
              "const": "daily",
              "description": "DailyOutputFiles: one file per input binary/day, named by {date}/{YYYYMMDD}/{day} or a _<date> suffix (aliases per_day, per-day, day)."
            }
          ]
        },
        "deflate_level": {"type": "integer", "minimum": 0, "maximum": 9, "default": 0},
        "shuffle": {"type": "boolean", "default": true},
        "snapshot_file": {"type": "string", "description": "Legacy alias for output.path."},
        "snapshot_hours": {"$ref": "#/definitions/hours"},
        "snapshot_interval_hours": {"type": "number", "exclusiveMinimum": 0},
        "fields": {"$ref": "#/definitions/output_fields"},
        "observations": {"$ref": "#/definitions/observation_output"}
      }
    },
    "observation_output": {
      "type": "object",
      "description": "Observation sampling ([output.observations] → ObservationOutputSpec). Samples the containing model cell at met-window ends and writes <path>_soundings.nc (point events: satellite soundings, ObsPack records, site time lists) and <path>_sites.nc (hourly station series). Files follow [output].split.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false → NoObservationOutput (sampling off, no files)."
        },
        "path": {
          "type": "string",
          "description": "Output path template. _soundings / _sites is inserted before the extension; {date}, {YYYYMMDD} or {day} are substituted per input binary (day index when the binary name has no date)."
        },
        "time_interpolation": {
          "description": "How point events are placed in time between met-window ends (AbstractObservationTimeInterpolation).",
          "default": "linear",
          "oneOf": [
            {
              "const": "linear",
              "description": "LinearWindowInterpolation: blend the air and tracer masses of the two window ends bracketing each event (interp_flag 0; 1 when only one sample exists)."
            },
            {
              "const": "nearest_window",
              "description": "NearestWindowSampling: use the single nearest window end (interp_flag 2)."
            }
          ]
        },
        "tracers": {
          "description": "Tracers to sample (Union{Nothing, Vector{Symbol}}); omit or \"all\" for every model tracer (nothing). Must exist in [tracers].",
          "anyOf": [
            {
              "const": "all",
              "description": "nothing: every model tracer."
            },
            {
              "type": "string",
              "description": "One tracer name."
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"},
              "description": "Tracer names, in output order."
            }
          ]
        },
        "write_profile_for_sites": {
          "type": "boolean",
          "default": false,
          "description": "Also write full profiles, interface pressures and layer air mass in the _sites file."
        },
        "layer_height_temperature_kelvin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 280.0,
          "description": "ConstantLayerTemperature used for intake-layer heights. Cubed-sphere binaries with GCHP VDIFF fields use their layer temperature instead (ProfileLayerTemperature)."
        },
        "start_time": {
          "description": "Run origin, ISO-8601 UTC string or TOML date-time; only used (and then required) when [input].start_date is absent. Must equal start_date at 00:00 when both are given."
        },
        "deflate_level": {"type": "integer", "minimum": 0, "maximum": 9, "default": 0},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/observation_source"},
          "description": "Where requests come from ([[output.observations.sources]] → AbstractObservationSource)."
        }
      }
    },
    "observation_source": {
      "type": "object",
      "description": "One [[output.observations.sources]] table; `kind` selects the AbstractObservationSource type.",
      "required": ["kind", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "oneOf": [
            {
              "const": "oco2_lite",
              "description": "OCO2LiteSource: NASA OCO-2/OCO-3 Lite files or OCO-2 v11 MIP 10-second averages (sounding_id, time, latitude, longitude). Point events only."
            },
            {
              "const": "obspack",
              "description": "ObsPackSource: NOAA ObsPack NetCDF files: per-record point events (mode = \"soundings\") or station series (mode = \"sites\")."
            },
            {
              "const": "table",
              "description": "TableSource: Your own CSV/TOML/NetCDF list of point events or sites (see schemas/observation_sites.schema.json)."
            }
          ]
        },
        "path": {
          "type": "string",
          "description": "File or template: {YYYYMMDD} or {date}, {YYMMDD}, {YYYY}, {MM}, {DD} are substituted per run day; * and ? wildcards in the file name. A path without date tokens must match."
        },
        "mode": {
          "description": "AbstractObservationMode. Required for obspack and table; oco2_lite is always soundings.",
          "oneOf": [
            {
              "const": "soundings",
              "description": "SoundingMode: point events, each sampled once at its own time and intake height (_soundings file)."
            },
            {
              "const": "sites",
              "description": "SiteMode: station series written at met-window ends per site schedule (_sites file; time lists become point events)."
            }
          ]
        },
        "quality_filter": {
          "description": "oco2_lite only (AbstractQualityFilter): which records become point events.",
          "default": "flag_max",
          "oneOf": [
            {
              "const": "flag_max",
              "description": "QualityFlagFilter(quality_variable, quality_flag_max): keep records with flag <= quality_flag_max (Lite files: xco2_quality_flag, 0 = good)."
            },
            {
              "const": "flag_values",
              "description": "QualityFlagValues(quality_variable, quality_flag_values): keep records whose flag is listed (MIP files: quality_variable = \"assimilate_flag\", values 0 = not assimilated, 1 = assimilated, 2 = withheld)."
            },
            {
              "const": "none",
              "description": "NoQualityFilter: keep every record (the OCO-2 v11 MIP co-samples all 10-s averages)."
            }
          ]
        },
        "quality_variable": {
          "type": "string",
          "minLength": 1,
          "default": "xco2_quality_flag",
          "description": "oco2_lite with quality_filter = \"flag_max\" or \"flag_values\": the integer flag variable to test."
        },
        "quality_flag_max": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "quality_filter = \"flag_max\" only: largest accepted flag value."
        },
        "quality_flag_values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer"},
          "description": "quality_filter = \"flag_values\" only (required there): accepted flag values, e.g. [1]."
        },
        "site_grouping": {
          "description": "obspack sites only (AbstractSiteGrouping).",
          "default": "site_code",
          "oneOf": [
            {
              "const": "site_code",
              "description": "SiteCodeGrouping: one site per dataset file and intake height; id = dataset name [+ _<h>magl]."
            },
            {
              "const": "location",
              "description": "LocationGrouping: one site per rounded (lat, lon, intake); id = <site_code>_<lat>N_<lon>E_<h>magl."
            }
          ]
        },
        "format": {
          "description": "table only (AbstractTableFormat).",
          "default": "auto",
          "oneOf": [
            {
              "const": "auto",
              "description": "AutoTableFormat: pick from the extension: .csv, .toml, .nc/.nc4."
            },
            {
              "const": "csv",
              "description": "CSVTableFormat: header line, comma-separated, # comments, no quoting; list-valued times use ';'."
            },
            {
              "const": "toml",
              "description": "TOMLTableFormat: [[soundings]] or [[sites]] arrays of tables; times may be a TOML array."
            },
            {
              "const": "netcdf",
              "description": "NetCDFTableFormat: 1-D variables along the record dimension; CF time units."
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "oco2_lite"}}, "required": ["kind"]},
          "then": {
            "not": {"anyOf": [{"required": ["format"]}, {"required": ["site_grouping"]}]},
            "properties": {"mode": {"const": "soundings"}}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "obspack"}}, "required": ["kind"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["format"]},
                {"required": ["quality_flag_max"]},
                {"required": ["quality_variable"]},
                {"required": ["quality_filter"]},
                {"required": ["quality_flag_values"]}
              ]
            },
            "required": ["mode"]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "table"}}, "required": ["kind"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["quality_flag_max"]},
                {"required": ["quality_variable"]},
                {"required": ["site_grouping"]},
                {"required": ["quality_filter"]},
                {"required": ["quality_flag_values"]}
              ]
            },
            "required": ["mode"]
          }
        },
        {
          "if": {
            "properties": {"quality_filter": {"const": "none"}},
            "required": ["quality_filter"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["quality_variable"]},
                {"required": ["quality_flag_max"]},
                {"required": ["quality_flag_values"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"quality_filter": {"const": "flag_values"}},
            "required": ["quality_filter"]
          },
          "then": {"required": ["quality_flag_values"], "not": {"required": ["quality_flag_max"]}}
        },
        {
          "if": {"not": {"required": ["quality_filter"]}},
          "then": {"not": {"required": ["quality_flag_values"]}}
        },
        {
          "if": {
            "properties": {"quality_filter": {"const": "flag_max"}},
            "required": ["quality_filter"]
          },
          "then": {"not": {"required": ["quality_flag_values"]}}
        },
        {
          "if": {
            "properties": {"kind": {"const": "obspack"}, "mode": {"const": "soundings"}},
            "required": ["kind", "mode"]
          },
          "then": {"not": {"required": ["site_grouping"]}}
        }
      ]
    },
    "hours": {
      "type": "array",
      "items": {"type": "number", "minimum": 0}
    },
    "output_fields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tracers": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "layers": {"$ref": "#/definitions/layer_selection"},
        "levels": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "column_mean": {"type": "boolean", "default": true},
        "column_mass_per_area": {"type": "boolean", "default": true},
        "air_mass_layers": {"$ref": "#/definitions/layer_selection"},
        "air_mass": {"type": "boolean", "default": true},
        "air_mass_per_area": {"type": "boolean", "default": true},
        "column_air_mass_per_area": {"type": "boolean", "default": true},
        "per_tracer": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/tracer_output_fields"}
        }
      }
    },
    "tracer_output_fields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "layers": {"$ref": "#/definitions/layer_selection"},
        "column_mean": {"type": "boolean"},
        "column_mass_per_area": {"type": "boolean"}
      }
    },
    "layer_selection": {
      "type": "string",
      "enum": ["full", "selected", "none"]
    }
  }
}
