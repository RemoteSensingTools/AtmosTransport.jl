# Julia
/Manifest.toml
/gpu-env/
/benchmarking/Manifest.toml
*.jl.cov
*.jl.mem
/docs/site/
/docs/build/
/docs/Manifest.toml
/docs/src/tutorials/_generated/

# DocumenterVitepress build artifacts (regenerated by `julia docs/make.jl`)
/docs/node_modules/
/docs/package-lock.json

# Data and outputs (keep scripts; ignore large NetCDF)
*.nc
*.gif
*.png
data/
!test/data/
!docs/src/assets/**/*.png
!docs/src/assets/**/*.gif

# Third-party / TM5 source (clone or zip extract; do not commit)
deps/

# Local GitHub Actions runner install
/actions-runner/

# IDE / OS
.DS_Store
.idea/
.cursor/
*.swp
*.swo
*~
__pycache__/

# Local env / secrets (do not commit)
.env
.env.local
*.local
.mcp.json
.claude/
.cursor/
docs/files.zip
docs/plans/

# Video frames (generated by make_point_sources_video.py)
video_frames/
scripts/Manifest.toml
test/Manifest.toml
.vscode/mcp.json
.codex
catrine_advonly_snapshot.png
*.bak

# stdout captures
nohup.out
*.nohup

/artifacts/

# Untracked plot outputs (collect diagnostic PNGs locally for VSCode
# preview without polluting `git status`). Already covered by the
# global `*.png` rule above, but listed explicitly so the intent is
# obvious in `.gitignore`.
/plots/

# Rust build output of tools such as tools/atmos-bin
/tools/*/target/
